// Generated by sudo-less install-config.sh — once after apt's dpkg runs,
// makes what they installed usable (tools/prefix-integrate.sh): refreshes
// the desktop database, gives programs that need the prefix view a script
// that runs them in it (docs/view.md), and runs the packages' systemd units
// as user units (docs/services.md). It finds the changed packages once and
// hands them to each step.
//
// Never fails an apt transaction.
DPkg::Post-Invoke:: "PREFIX=@PREFIX@ @PREFIX@/lib/sudo-less/prefix-integrate || true";
