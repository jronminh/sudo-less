// Generated by sudo-less install-config.sh — after every dpkg run, gives
// each newly installed program that needs the prefix view a script in
// @PREFIX@/bin that runs it in the shared run view, removes the scripts of
// removed packages, and stops the run view so the next program run sees the
// new files (tools/prefix-wrap.sh, docs/view.md). Programs that do not need
// the view run directly from @PREFIX@/usr/bin.
//
// Never fails an apt transaction.
DPkg::Post-Invoke:: "PREFIX=@PREFIX@ @PREFIX@/lib/sudo-less/prefix-wrap || true";
