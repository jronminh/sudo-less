// Generated by sudo-less install-config.sh — before dpkg runs, reads each
// .deb apt is about to install and stops the whole run, with the package
// and the reason, if one needs root to install (a system user, kernel
// modules, ...). Nothing is unpacked, so a package that cannot work never
// half-installs and wedges the prefix (tools/prefix-check.sh,
// docs/standard.md). SUDO_LESS_CHECK=off skips it.
DPkg::Pre-Install-Pkgs:: "PREFIX=@PREFIX@ @PREFIX@/lib/sudo-less/prefix-check";
