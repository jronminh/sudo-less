// Generated by sudo-less install-config.sh — after every dpkg run (and after
// 02view-wrappers, whose scripts it looks at), translates the systemd units
// of each installed or changed package into user units the user's own
// systemd runs, starts those the package enabled, and removes the units of
// removed packages (tools/prefix-units.sh). SUDO_LESS_UNITS=off skips it.
//
// Never fails an apt transaction.
DPkg::Post-Invoke:: "PREFIX=@PREFIX@ @PREFIX@/lib/sudo-less/prefix-units || true";
