# Generated by sudo-less install-config.sh from apt-dpkg/config/dpkg/dpkg.cfg.in.
# dpkg runs in the prefix view (docs/view.md), where this file is
# /etc/dpkg/dpkg.cfg and the root, admin dir and log are Debian's own:
# /, /var/lib/dpkg and /var/log/dpkg.log, all of them in the prefix.
force-not-root
log /var/log/dpkg.log
