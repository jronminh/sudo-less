# Generated by sudo-less install-config.sh from config/dpkg/dpkg.cfg.in.
# dpkg reads this file from its own prefix (patches/dpkg/0100-relocatable.patch),
# so a plain `dpkg -i x.deb` installs into the prefix, as apt does
# (config/apt.conf.d/00local-prefix.in passes the same options).
instdir @PREFIX@
admindir @PREFIX@/var/lib/dpkg
force-script-chrootless
force-not-root
log @PREFIX@/var/log/dpkg.log
