Origin: termux-packages 91af886 packages/dpkg/src-archives.c.patch and src-statoverride-main.c.patch
Change: adapted: only the chown/fchown/lchown removals, without #ifndef __ANDROID__; a user cannot give files away, and the prefix belongs to the user. The Android-only parts (rename instead of hard links, symlink size warnings) are not taken. Native need. Rebased onto dpkg 1.23 (tab indentation, new messages).
License: GPL-2.0-or-later

diff --git a/src/main/archives.c b/src/main/archives.c
--- a/src/main/archives.c
+++ b/src/main/archives.c
@@ -427,10 +427,6 @@ tarobject_extract(struct tarcontext *tc, struct tar_entry *te,
 			      namenode->statoverride->uid,
 			      namenode->statoverride->gid,
 			      namenode->statoverride->mode);
-		rc = fchown(fd, st->uid, st->gid);
-		if (forcible_nonroot_error(rc))
-			ohshite(_("cannot set ownership of '%s'"),
-			        te->name);
 		rc = fchmod(fd, st->mode & ~S_IFMT);
 		if (forcible_nonroot_error(rc))
 			ohshite(_("cannot set permissions of '%s'"),
@@ -577,15 +573,7 @@ tarobject_set_perms(struct tar_entry *te, const char *path, struct file_stat *st
 		/* Already handled using the file descriptor. */
 		return;
 
-	if (te->type == TAR_FILETYPE_SYMLINK) {
-		rc = lchown(path, st->uid, st->gid);
-		if (forcible_nonroot_error(rc))
-			ohshite(_("cannot set ownership of symbolic link '%s'"),
-			        path);
-	} else {
-		rc = chown(path, st->uid, st->gid);
-		if (forcible_nonroot_error(rc))
-			ohshite(_("cannot set ownership of '%s'"), path);
+	if (te->type != TAR_FILETYPE_SYMLINK) {
 		rc = chmod(path, st->mode & ~S_IFMT);
 		if (forcible_nonroot_error(rc))
 			ohshite(_("cannot set permissions of '%s'"),
@@ -1182,10 +1170,6 @@ tarobject(struct tar_archive *tar, struct tar_entry *ti)
 			if (symlink(symlinkfn.buf, fnametmpvb.buf))
 				ohshite(_("cannot make backup symbolic link for '%s'"),
 				        ti->name);
-			rc = lchown(fnametmpvb.buf, stab.st_uid, stab.st_gid);
-			if (forcible_nonroot_error(rc))
-				ohshite(_("cannot set ownership of backup symbolic link for '%s'"),
-				        ti->name);
 			tarobject_set_se_context(fnamevb.buf, fnametmpvb.buf,
 			                         stab.st_mode);
 		} else {
diff --git a/src/statoverride/main.c b/src/statoverride/main.c
--- a/src/statoverride/main.c
+++ b/src/statoverride/main.c
@@ -222,9 +222,6 @@ statdb_node_apply(const char *filename, struct file_stat *filestat)
 {
 	int rc;
 
-	rc = chown(filename, filestat->uid, filestat->gid);
-	if (forcible_nonroot_error(rc) < 0)
-		ohshite(_("cannot set ownership of '%s'"), filename);
 	rc = chmod(filename, filestat->mode & ~S_IFMT);
 	if (forcible_nonroot_error(rc) < 0)
 		ohshite(_("cannot set permissions of '%s'"), filename);
