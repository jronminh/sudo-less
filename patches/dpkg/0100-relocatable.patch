Origin: sudo-less
Change: patch A. dpkg finds its prefix at run time from /proc/self/exe (PREFIX/bin/NAME) and relocates the paths compiled in under the build prefix: the config dir (dpkg.cfg) and the default admin dir. dpkg-maintscript-helper falls back to ../share/dpkg next to itself (dpkg-realpath is a C program since dpkg 1.23). A prebuilt dpkg then works in any user's prefix.
License: GPL-2.0-or-later

diff --git a/lib/dpkg/Makefile.am b/lib/dpkg/Makefile.am
--- a/lib/dpkg/Makefile.am
+++ b/lib/dpkg/Makefile.am
@@ -4,6 +4,7 @@ AM_CPPFLAGS = \
 	-DLOCALEDIR=\"$(localedir)\" \
 	-DCONFIGDIR=\"$(pkgconfdir)\" \
 	-DADMINDIR=\"$(admindir)\" \
+	-DBUILD_PREFIX=\"$(prefix)\" \
 	-DDEFAULT_TEXT_DOMAIN=\"@PACKAGE@\" \
 	-idirafter $(top_srcdir)/lib/compat \
 	-I$(top_builddir) \
diff --git a/lib/dpkg/dbdir.c b/lib/dpkg/dbdir.c
--- a/lib/dpkg/dbdir.c
+++ b/lib/dpkg/dbdir.c
@@ -52,8 +52,12 @@ dpkg_db_new_dir(void)
 	env = getenv("DPKG_ADMINDIR");
 	if (env)
 		dir = file_canonicalize(env);
-	else
-		dir = dpkg_fsys_get_path(ADMINDIR);
+	else {
+		char *admindir = dpkg_reloc_path(ADMINDIR);
+
+		dir = dpkg_fsys_get_path(admindir);
+		free(admindir);
+	}
 
 	return dir;
 }
diff --git a/lib/dpkg/fsys-dir.c b/lib/dpkg/fsys-dir.c
--- a/lib/dpkg/fsys-dir.c
+++ b/lib/dpkg/fsys-dir.c
@@ -21,7 +21,10 @@
 #include <config.h>
 #include <compat.h>
 
+#include <limits.h>
 #include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
 
 #include <dpkg/dpkg.h>
 #include <dpkg/string.h>
@@ -130,3 +133,51 @@ dpkg_fsys_get_path(const char *pathpart)
 
 	return str_fmt("%s/%s", dpkg_fsys_get_dir(), pathpart);
 }
+
+/**
+ * Relocate a path compiled in under the build prefix.
+ *
+ * The prefix is found at run time from /proc/self/exe: a program installed
+ * as PREFIX/bin/NAME or PREFIX/sbin/NAME has the prefix PREFIX. If the path
+ * does not start with the build prefix, or the prefix cannot be found, the
+ * path is returned unchanged.
+ *
+ * @param path The compiled-in path.
+ *
+ * @return The relocated path, newly allocated.
+ */
+char *
+dpkg_reloc_path(const char *path)
+{
+	static char *prefix;
+	static bool prefix_init;
+	size_t build_len = strlen(BUILD_PREFIX);
+
+	if (!prefix_init) {
+		char exe[PATH_MAX];
+		ssize_t len;
+		char *slash;
+
+		prefix_init = true;
+		len = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+		if (len > 0) {
+			exe[len] = '\0';
+			slash = strrchr(exe, '/');
+			if (slash) {
+				*slash = '\0';
+				slash = strrchr(exe, '/');
+			}
+			if (slash && (strcmp(slash, "/bin") == 0 ||
+			              strcmp(slash, "/sbin") == 0)) {
+				*slash = '\0';
+				prefix = m_strdup(exe);
+			}
+		}
+	}
+
+	if (prefix == NULL || strncmp(path, BUILD_PREFIX, build_len) != 0 ||
+	    (path[build_len] != '/' && path[build_len] != '\0'))
+		return m_strdup(path);
+
+	return str_fmt("%s%s", prefix, path + build_len);
+}
