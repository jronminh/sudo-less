# pmarkdown — pure-Perl CLI (Markdown::Perl + its own deps: Readonly,
# List::MoreUtils, Unicode::CaseFold, YAML::Tiny). check-package.sh calls it
# "OK"/direct: its own /usr/bin/pmarkdown has no absolute paths baked in, but
# system perl's compiled-in @INC (/usr/share/perl5, /usr/lib/<arch>/perl5/<ver>)
# never includes $PREFIX, so `use Markdown::Perl;` fails outright — the same
# module-search-path gap as Python's sys.path (see #5's .pth fix for
# ranger), just invisible to the classifier because it only scans binaries,
# not perl's own @INC. See #7.
#
# CAVEAT: the arch/version path segment (x86_64-linux-gnu/perl5/5.42) is this
# host's perl ABI triplet, not portable — regenerate it per host
# (`perl -MConfig -e'print "$Config{archname}/perl5/$Config{version}"'`). v1's
# env key only substitutes $PREFIX, no other variables.
package  pmarkdown
install  ok
mechanism  env
env      PERL5LIB=$PREFIX/usr/share/perl5:$PREFIX/usr/lib/x86_64-linux-gnu/perl5/5.42
verify   pmarkdown --version
note     arch/version-pinned PERL5LIB; regenerate the triplet per host
