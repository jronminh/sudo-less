# ranger — pure Python. Raw check-package verdict is "risky" (was "unlikely"
# before #5's check-package.sh fix downgraded py3compile+dist-packages from a
# hard blocker to a shipped fix): its postinst byte-compiles into the absolute
# /usr/lib/python3/dist-packages (ignoring the prefix). The py3compile shim
# gets it installed; sys.path is handled globally by install-config.sh's
# 00-sudo-less.pth in the system python3's user site (points at
# $PREFIX/usr/lib/python3/dist-packages) — no per-recipe env needed, so tier
# is direct once the shim is in place.
package  ranger
install  risky
tier     direct
shim     py3compile
verify   ranger --version
