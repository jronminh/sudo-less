#!/bin/sh
# updo-admin: the admin's one tool for updo. updo.conf is the only source of
# truth; units are generated from it at boot and on every apply
# (updo-generator), users are created from it (systemd-sysusers).
#
#   updo-admin check    validate /etc/updo/updo.conf and conf.d/*.conf
#   updo-admin apply    validate, create the identities' users, regenerate
#                       the units, (re)start their sockets, stop removed ones
#   updo-admin list     enabled identities and their sockets
#
#   updo-admin --dev [--config FILE] apply | stop | env
#                       the same as your own user units, to test without
#                       root: the sandbox, policy and protocol are real, the
#                       identity is you (a user manager cannot switch users)
set -eu

UPDOD="${UPDOD:-/usr/libexec/updo/updod}"
CONF=/etc/updo/updo.conf
DEV=
HERE="$(cd "$(dirname "$0")" && pwd)"

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dev) DEV=1 ;;
    --config) CONF="$(realpath "$2")"; shift ;;
    -h|--help) usage 0 ;;
    *) break ;;
  esac
  shift
done
[ $# -ge 1 ] || usage

if [ -n "$DEV" ]; then
  # a source checkout: use (and build) its updod
  if [ -x "$HERE/build.sh" ]; then "$HERE/build.sh" >/dev/null; UPDOD="$HERE/out/updod"; fi
  RT="${XDG_RUNTIME_DIR:?}"
  D="$RT/updo-dev"
  UNITS="$RT/systemd/user"
  SC="systemctl --user"
else
  UNITS=/run/systemd/generator
  SC=systemctl
fi

running() { $SC list-units --plain --no-legend --all 'updo-*.socket' | awk '{print $1}'; }

stop_removed() {
  keep=" $(printf '%s ' $("$UPDOD" --identities --config "$CONF")) "
  for u in $(running); do
    n="${u#updo-}"; n="${n%.socket}"
    case "$keep" in *" $n "*) ;; *) $SC stop "$u"; echo "stopped: $n" ;; esac
  done
}

case "$1" in
  check)
    "$UPDOD" --check --config "$CONF" && echo "$CONF: ok" ;;
  list)
    for n in $("$UPDOD" --identities --config "$CONF"); do
      printf '%-16s %s\n' "$n" "$($SC is-active "updo-$n.socket" || true)"
    done ;;
  apply)
    "$UPDOD" --check --config "$CONF" || { echo "nothing changed" >&2; exit 1; }
    if [ -n "$DEV" ]; then
      mkdir -p "$D/bin" "$UNITS"
      # the sandbox has a private /tmp and a read-only $HOME: copy both in
      install -m 755 "$UPDOD" "$D/bin/updod"
      rm -rf "$D/etc"; mkdir -p "$D/etc"
      cp "$CONF" "$D/etc/updo.conf"
      [ ! -d "$(dirname "$CONF")/conf.d" ] || cp -r "$(dirname "$CONF")/conf.d" "$D/etc/"
      CONF="$D/etc/updo.conf"
      rm -f "$UNITS"/updo-*.socket "$UNITS"/updo-*@.service "$UNITS"/sockets.target.wants/updo-*
      "$UPDOD" --generate "$UNITS" --config "$CONF" --dev --rundir "$D" --updod "$D/bin/updod"
      $SC daemon-reload
    else
      [ "$(id -u)" = 0 ] || { echo "updo-admin apply: run as root" >&2; exit 1; }
      [ "$CONF" = /etc/updo/updo.conf ] || { echo "the generator reads /etc/updo/updo.conf only" >&2; exit 1; }
      users="$("$UPDOD" --sysusers --config "$CONF")"
      [ -z "$users" ] || printf '%s\n' "$users" | systemd-sysusers -
      $SC daemon-reload                            # reruns updo-generator
    fi
    stop_removed
    for n in $("$UPDOD" --identities --config "$CONF"); do
      $SC restart "updo-$n.socket"; echo "enabled: $n"
    done
    [ -z "$DEV" ] || echo "export UPDO_RUNDIR=$D" ;;
  stop)
    [ -n "$DEV" ] || usage
    for u in $(running); do $SC stop "$u"; done
    rm -f "$UNITS"/updo-*.socket "$UNITS"/updo-*@.service "$UNITS"/sockets.target.wants/updo-*
    $SC daemon-reload
    rm -rf "$D" ;;
  env)
    [ -n "$DEV" ] || usage
    echo "export UPDO_RUNDIR=$D" ;;
  *) usage ;;
esac
